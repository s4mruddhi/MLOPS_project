# Enterprise RAGOps Knowledge Assistant Environment Configuration

# RAG & LLM Engine Settings
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_TF=0
USE_TORCH=1

# Storage & Database Paths
DATA_DIR=c:\MLOPS_project\data
CHROMA_DB_DIR=c:\MLOPS_project\data\processed\chroma_db

# MLOps & Experiment Tracking
MLFLOW_TRACKING_URI=sqlite:///c:/MLOPS_project/mlflow.db
EXPERIMENT_NAME=Enterprise_Knowledge_Assistant_RAG_Ops

# Airflow Settings
AIRFLOW_HOME=c:\MLOPS_project\airflow
AIRFLOW_UI_URL=http://localhost:8080

# Application Server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
