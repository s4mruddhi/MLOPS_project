{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Total RAG HTTP Requests",
      "type": "stat",
      "targets": [{ "expr": "sum(ragops_http_requests_total)", "refId": "A" }],
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
    },
    {
      "title": "Query Latency p95 (seconds)",
      "type": "gauge",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(ragops_query_latency_seconds_bucket[5m])) by (le))", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 1.5 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 }
    },
    {
      "title": "Top Retrieval Similarity Score",
      "type": "gauge",
      "targets": [{ "expr": "ragops_top_retrieval_score", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.35 },
              { "color": "green", "value": 0.6 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 }
    },
    {
      "title": "Total HTTP Server Errors",
      "type": "stat",
      "targets": [{ "expr": "sum(ragops_http_errors_total)", "refId": "A" }],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
    },
    {
      "title": "Average RAG Query Processing Latency (1m)",
      "type": "timeseries",
      "targets": [{ "expr": "rate(ragops_query_latency_seconds_sum[1m]) / rate(ragops_query_latency_seconds_count[1m])", "refId": "A" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ragops", "prometheus", "fastapi", "mlops"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "RAGOps Knowledge Assistant Health & Performance Dashboard",
  "version": 1
}
